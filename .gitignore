# OS
.DS_Store

# Environment / secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/

# Python bytecode & caches
__pycache__/
*.py[cod]

# Packaging output
*.egg-info/
build/
dist/

# uv
# (uv.lock is committed intentionally for reproducible envs)

# Ruff
.ruff_cache/

# pytest
# (.pytest_cache/ needs no entry — pytest writes its own .gitignore inside it)

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Editors
# Track shared, portable project config; ignore personal/local VS Code noise.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/*.code-snippets
.idea/

# Data & results (large / generated)
data_in/*
!data_in/.gitkeep
# ...except labelled benchmark sets, which are research instruments rather than inputs:
# a result is only reproducible if the set it was scored against is versioned with the code
!data_in/*_benchmark.csv
data_results/*
!data_results/.gitkeep
